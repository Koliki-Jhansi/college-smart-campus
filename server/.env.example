# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/collegehub
# Example Atlas: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxx.mongodb.net/collegehub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/collegehub

# JWT Authentication Secrets
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_KEY_HERE
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Client Web Application URL (for CORS and Socket.IO validation)
CLIENT_URL=http://localhost:5175

# File Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15
